LLM_PROVIDER=gemini

# FP5 answer generation uses Gemini. Keep the real key only in the ignored .env.
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-2.5-flash
# Comma-separated deployment-approved options shown in the Chat model selector.
LLM_CHAT_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.9
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
ALLOW_PAID_GENERATION=0
ALLOW_UNKNOWN_GENERATION_COST=0
MAX_GENERATION_COST=0.25
# Browser-created test runs are intentionally bounded while they run synchronously.
MAX_TEST_RUN_RESPONSES=5
# Browser-triggered LLM-judge/RAGAS calls have their own explicit policy.
ALLOW_PAID_EVALUATION=0
ALLOW_UNKNOWN_EVALUATION_COST=0
MAX_EVALUATOR_APPLICATIONS=5
MAX_EVALUATION_COST=1.00
RETRIEVAL_TOP_K=3
LLM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# FP8 advanced evaluation is opt-in from the CLI. Zero pricing means unknown,
# not free; execution remains blocked without a separate unknown-cost override.
EVALUATOR_PROVIDER=gemini
EVALUATOR_MODEL=gemini-3.1-flash-lite
EVALUATOR_TEMPERATURE=0.0
EVALUATOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EVALUATOR_INPUT_COST_PER_MILLION=0
EVALUATOR_OUTPUT_COST_PER_MILLION=0
RAGAS_DO_NOT_TRACK=true

# FP5 uses Chroma's local all-MiniLM-L6-v2 embedding model by default.
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Optional provider-specific keys if the implementation supports multiple providers.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=llm_rag_evals
DB_USER=root
DB_PASSWORD=replace_with_local_password

CHROMA_PATH=rag/chroma
CHROMA_COLLECTION=metrostate_documents
